#!/bin/sh
# Pre-commit gate. A commit over a failing check is impossible from here.
#
# This exists because it already happened: on 2026-09-24 check_prohibitions
# fired on Phase 6 and the commit went through anyway, and the next commit had
# to undo it. A suite you can commit past is advisory, and an advisory suite is
# one that gets ignored on exactly the night it matters.
#
# Versioned under .githooks and wired up with
#   git config core.hooksPath .githooks
# so it travels with the repo instead of living in one clone's .git directory.
#
# Deliberately NOT bypassable in normal use. `git commit --no-verify` still
# works, because git provides it and nothing here can take it away, but it
# leaves no trace in the commit and the reviewer should treat its use as a
# thing to explain.

set -e
cd "$(git rev-parse --show-toplevel)"

PY=python3
FAILED=""

run () {
  name="$1"; shift
  if out=$("$@" 2>&1); then
    printf '  %-26s ok\n' "$name"
  else
    printf '  %-26s FAILED\n' "$name"
    printf '%s\n' "$out" | sed 's/^/      /' | head -20
    FAILED="$FAILED $name"
  fi
}

echo "pre-commit:"

# Offline checks. Every one of these runs with no credentials and no network.
run check_prohibitions  $PY scripts/check_prohibitions.py
run check_deliverables  $PY scripts/check_deliverables.py
run check_css           $PY scripts/check_css.py
run check_palette       $PY scripts/check_palette.py

# ALL NINE fixture suites. Until 2026-09-25 only three of the nine ran here and
# the other six ran nowhere at all: they passed, but nothing would have noticed
# if they stopped. A suite wired into no gate is a suite that is green until the
# night it matters. The two that need live credentials, check_rls and
# check_price_drift, run in scripts/deploy.sh instead.
run analysis_fixtures   node tests/analysis_fixtures.mjs
run autonomy_fixtures   node tests/autonomy_fixtures.mjs
run brief_clock         node tests/brief_clock.mjs
run completion_fixtures node tests/completion_fixtures.mjs
run settings_fixtures   node tests/settings_fixtures.mjs
# Location derivation. The structural checks read the prefix tables out of the
# source, so a hand edit that overlaps two ranges or points at a state with no
# timezone fails the commit rather than a member's first morning brief.
run geo_fixtures        node tests/geo_fixtures.mjs
# Held results. The set of reasons a row can be held for lives in a database
# constraint, in normalize(), and in wording on two screens. This is the only
# thing that notices those four drifting apart.
run held_fixtures       node tests/held_fixtures.mjs
run coach_fixtures      $PY tests/coach_fixtures.py
# The constant pins. A behavioural fixture passes at whatever the constant
# currently is; this is the only thing that notices the number moved.
run consent_fixtures    node tests/consent_fixtures.mjs
run cohortless_fixtures node tests/cohortless_fixtures.mjs
# Money. The failure mode is charging a real person the wrong amount, so these
# run before every commit and compare the page a buyer reads to the code.
run billing_fixtures    node tests/billing_fixtures.mjs
run discount_fixtures   node tests/discount_fixtures.mjs
run onboarding_fixtures node tests/onboarding_fixtures.mjs
run checkin_fixtures    node tests/checkin_fixtures.mjs
run constants_pinned    node tests/constants_pinned.mjs

# check_claims runs LAST, per CLAUDE.md: it is the one that has to see the tree
# exactly as it will be committed.
run check_claims        $PY scripts/check_claims.py

if [ -n "$FAILED" ]; then
  echo
  echo "COMMIT REFUSED. Failing:$FAILED"
  echo "Fix the check. Do not commit over it."
  exit 1
fi
echo "  all clean, commit allowed"
exit 0
