# Template for .dev.vars. Copy to .dev.vars and fill in. .dev.vars is
# gitignored and must stay that way: it holds live secrets.
#
# Every name here is read somewhere in the codebase. A name missing from
# .dev.vars does not fail loudly, it fails as a feature quietly not working,
# which is how VOYAGE_API_KEY went unnoticed until the corpus had no vectors.

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Anthropic, every agent ----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Voyage, corpus embeddings -------------------------------------------
# REQUIRED FOR SEMANTIC RETRIEVAL. Without it every row in
# knowledge_passages has a null embedding and search_passages falls back to
# lexical ranking, which works but puts a question about DHA in the wrong
# chapter. Once this is set, run ONE command:
#
#     python3 scripts/load_corpus.py --reembed
#
# It is idempotent on content hash: it embeds only rows whose vector is
# missing or whose embed_model no longer matches EMBED_MODEL, and leaves the
# passage text untouched, so it is a rerun rather than a reload.
VOYAGE_API_KEY=pa-REPLACE_ME

# --- Resend, transactional email -----------------------------------------
RESEND_API_KEY=re_REPLACE_ME
FROM_EMAIL=admin@thehumanbatteryproject.com
NOTIFY_EMAIL=drmicah@thehumanbatteryproject.com

# --- Server to server ----------------------------------------------------
# The ONLY secret the brief cron Worker holds.
WEBHOOK_SECRET=REPLACE_ME

# --- Stripe. PARKED until HBP is incorporated ----------------------------
# Both must change together when going live: see CLAUDE.md rule 8c.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
